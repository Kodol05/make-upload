{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k-sort-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-06",

  // GEMINI_API_KEY는 여기 두지 않는다. 로컬은 .dev.vars, 배포는 secret으로만 넣는다.
  //   npx wrangler secret put GEMINI_API_KEY
  "vars": {
    "ALLOWED_ORIGIN": "https://kodol05.github.io"
  },

  // 세션별 사용량 제한. 설계 문서가 정한 값이다.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SCAN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  // Gemini는 일부 지역에서 오는 요청을 막는다. Worker를 백엔드에 가까운 곳에 두어
  // 출구 IP가 지원 지역이 되도록 한다.
  "placement": { "mode": "smart" },

  "observability": {
    // 프롬프트와 사용자가 보낸 내용이 로그에 남지 않도록 본문을 기록하지 않는다.
    "enabled": true
  }
}
